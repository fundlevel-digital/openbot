#!/bin/bash
set -euo pipefail
umask 077

# This mode runs only inside the private browser Xvfb below. Its window manager is a child of
# this wrapper, so it stops before xvfb-run removes the display. The agent display is not changed.
if [ "${1:-}" = --browser-display ]; then
  shift
  if [ "${OPENBOT_PRIVATE_BROWSER_DISPLAY:-}" != 1 ] || [ -z "${DISPLAY:-}" ] ||
    [ "$DISPLAY" = "${OPENBOT_AGENT_DISPLAY:-}" ] || [ "$#" -eq 0 ]; then
    echo "The browser window manager requires OpenBot's private display." >&2
    exit 1
  fi
  unset OPENBOT_PRIVATE_BROWSER_DISPLAY
  wm_pid=""
  app_pid=""
  cleanup_browser_display() {
    if [ -n "$wm_pid" ]; then
      kill -TERM "$wm_pid" 2>/dev/null || true
      wait "$wm_pid" 2>/dev/null || true
    fi
  }
  stop_browser_display() {
    if [ -n "$app_pid" ]; then
      kill -TERM "$app_pid" 2>/dev/null || true
      wait "$app_pid" 2>/dev/null || true
    fi
    exit 143
  }
  trap cleanup_browser_display EXIT
  trap stop_browser_display TERM INT
  browser_wm_ready() {
    local root_check child_check window_id supported
    root_check=$(xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null) || return 1
    [[ $root_check =~ window\ id\ \#\ (0x[0-9a-fA-F]+) ]] || return 1
    window_id=${BASH_REMATCH[1]}
    [ "$window_id" != 0x0 ] || return 1
    child_check=$(xprop -id "$window_id" _NET_SUPPORTING_WM_CHECK 2>/dev/null) || return 1
    [[ $child_check == *"window id # $window_id"* ]] || return 1
    supported=$(xprop -root _NET_SUPPORTED 2>/dev/null) || return 1
    # An empty display has no active client yet. The manager must advertise the activation
    # capability; the OS driver verifies the active window when it dispatches browser input.
    [[ $supported == *_NET_ACTIVE_WINDOW* ]]
  }
  # A private Xvfb starts empty. Do not replace or stop a manager if a caller supplied another display.
  if browser_wm_ready; then
    echo "The private browser display already has a window manager." >&2
    exit 1
  fi
  openbox --sm-disable >/dev/null 2>&1 &
  wm_pid=$!
  for _ in $(seq 1 100); do
    kill -0 "$wm_pid" 2>/dev/null || break
    browser_wm_ready && break
    sleep 0.1
  done
  if ! kill -0 "$wm_pid" 2>/dev/null || ! browser_wm_ready; then
    echo "The private browser window manager did not start." >&2
    exit 1
  fi
  "$@" &
  app_pid=$!
  status=0
  wait "$app_pid" || status=$?
  exit "$status"
fi

# ExecStop of openbot.service. The unit also holds the virtual displays, and its stop signal goes to
# each of its processes at the same time. An Xvfb that stops first ends OpenBot before it closes its
# database. So this gives the signal to OpenBot only and waits for it; the unit then stops the rest.
service_openbot() {
  local comm
  [[ $1 =~ ^[1-9][0-9]*$ ]] || return 1
  if [ -d /proc/self ]; then
    comm=$(cat "/proc/$1/comm" 2>/dev/null) || return 1
  else
    comm=$(ps -o comm= -p "$1" 2>/dev/null) || return 1
  fi
  [ "${comm##*/}" = openbot ] && [ "$(cat "/proc/$1/cgroup" 2>/dev/null)" = "$(cat /proc/$$/cgroup 2>/dev/null)" ]
}

if [ "${1:-}" = --stop ]; then
  pid=$(cat "$XDG_RUNTIME_DIR/openbot.pid" 2>/dev/null) || pid=""
  if service_openbot "$pid" && kill -TERM "$pid" 2>/dev/null; then
    while [ -e "/proc/$pid" ]; do sleep 0.2; done
  fi
  main=${MAINPID:-}
  if [[ $main =~ ^[1-9][0-9]*$ ]]; then
    for _ in $(seq 1 50); do
      grep -qs '^State:[[:space:]]*[^Z[:space:]]' "/proc/$main/status" || break
      sleep 0.2
    done
  fi
  exit 0
fi
if [ "${1:-}" = --watchdog ]; then
  pid_file=$2 user_data=$3 interval=$4 limit=$5
  heartbeat="$user_data/openbot-run-marker-v1.json"
  start_attempts="$user_data/openbot-start-attempts-v1.json"
  started_and_running() {
    grep -qs '"state":"running"' "$heartbeat" && grep -qs '"attempt":null' "$start_attempts"
  }
  seen=$(cat "$heartbeat" 2>/dev/null) || seen=""
  armed=0 misses=0
  while sleep "$interval"; do
    current=$(cat "$heartbeat" 2>/dev/null) || current=""
    if [ "$current" != "$seen" ]; then
      seen=$current armed=1 misses=0
      continue
    fi
    [ "$armed" -eq 1 ] || continue
    if ! started_and_running; then
      misses=0
      continue
    fi
    misses=$((misses + 1))
    [ "$misses" -ge "$limit" ] || continue
    free_kb=$(df -Pk "$user_data" 2>/dev/null | awk 'NR == 2 { print $4 }') || free_kb=""
    if [[ ! $free_kb =~ ^[0-9]+$ ]] || [ "$free_kb" -lt 1024 ]; then continue; fi
    pid=$(cat "$pid_file" 2>/dev/null) || pid=""
    if ! service_openbot "$pid"; then
      armed=0 misses=0
      continue
    fi
    echo "OpenBot did not update its heartbeat for $((interval * limit)) seconds. The watchdog stops it, and systemd starts it again." >&2
    kill -KILL "$pid" 2>/dev/null || true
    exit 0
  done
  exit 0
fi
state="$HOME/.config/openbot-hosted"
mode=hosted
if [ -r /opt/OpenBot/hosted/mode ] && [ "$(</opt/OpenBot/hosted/mode)" = self ]; then mode=self; fi

if [ "${1:-}" != --in-session ] && [ "$mode" = self ]; then
  mkdir -p "$state"
  chmod 0700 "$state"
  exec dbus-run-session -- "$0" --in-session
fi
if [ "${1:-}" != --in-session ]; then
  for _ in $(seq 1 300); do
    [ -s "$state/env" ] && break
    sleep 2
  done
  [ -s "$state/env" ] || { echo "The hosted server env file is missing." >&2; exit 1; }
  exec dbus-run-session -- "$0" --in-session
fi

if [ "$mode" = hosted ]; then
  while IFS='=' read -r key value; do
    case $key in
      OPENBOT_HOSTED_HOST_ID | OPENBOT_HOSTED_CLAIM) export "$key=$value" ;;
    esac
  done <"$state/env"
  export OPENBOT_HOSTED_SERVER=1
else
  export OPENBOT_SERVER=1
fi
requested_size=""
if [ -r /opt/OpenBot/hosted/openbot.env ]; then
  while IFS='=' read -r key value || [ -n "$key" ]; do
    case $key in
      OPENBOT_AUTH_API_URL) export "$key=$value" ;;
      OPENBOT_DISPLAY_SIZE) requested_size=$value ;;
    esac
  done </opt/OpenBot/hosted/openbot.env
fi

display_size() {
  if [[ $1 =~ ^([1-9][0-9]{2,3})x([1-9][0-9]{2,3})$ ]] &&
    [ "${BASH_REMATCH[1]}" -ge 640 ] && [ "${BASH_REMATCH[1]}" -le 2576 ] &&
    [ "${BASH_REMATCH[2]}" -ge 480 ] && [ "${BASH_REMATCH[2]}" -le 2576 ]; then
    echo "$1"
    return
  fi
  [ -z "$1" ] || echo "OPENBOT_DISPLAY_SIZE is not WIDTHxHEIGHT from 640x480 to 2576x2576. The display is 1280x800." >&2
  echo 1280x800
}

if [ ! -s "$state/keyring-password" ] && [ -e /srv/openbot-hosted/keyrings/login.keyring ]; then
  echo "The keyring exists, but its password file is missing." >&2
  exit 1
fi
if [ ! -s "$state/keyring-password" ]; then
  temporary=$(mktemp "$state/keyring-password.XXXXXX")
  head -c 32 /dev/urandom | base64 | tr -d '\n' >"$temporary"
  mv -f "$temporary" "$state/keyring-password"
fi
export XDG_DATA_HOME=/srv/openbot-hosted
keyrings="$XDG_DATA_HOME/keyrings"
mkdir -p "$keyrings"
printf login >"$keyrings/default"
unlocked=$(gnome-keyring-daemon --unlock --components=secrets <"$state/keyring-password")
eval "$unlocked"
started=$(gnome-keyring-daemon --start --components=secrets)
eval "$started"
unset XDG_DATA_HOME
export GNOME_KEYRING_CONTROL

(
  for _ in $(seq 1 300); do
    case $(findmnt -n -o FSTYPE -T "$keyrings" || true) in fuse*) sleep 2 ;; *) break ;; esac
  done
  sleep 10
  for keyring in "$keyrings"/*.keyring; do
    [ -e "$keyring" ] || continue
    find "$keyrings" -maxdepth 1 -name "${keyring##*/}.temp-*" ! -samefile "$keyring" -delete
  done
) &

"$0" --watchdog "$XDG_RUNTIME_DIR/openbot.pid" "${XDG_CONFIG_HOME:-$HOME/.config}/OpenBot" 30 20 &

openbot=(bash -c 'echo "$$" >"$XDG_RUNTIME_DIR/openbot.pid" && exec "$@"' openbot-hosted-server
  /opt/OpenBot/app/openbot --password-store=gnome-libsecret)
browser_display=(env OPENBOT_PRIVATE_BROWSER_DISPLAY=1 "$0" --browser-display "${openbot[@]}")
if [ "$mode" = hosted ] && [ -e /etc/systemd/system/display-manager.service ]; then
  search=0
  pgrep -u "$(id -u)" -x xauth >/dev/null 2>&1 || search=$?
  if [ "$search" -eq 1 ]; then rm -f "$HOME/.Xauthority-c" "$HOME/.Xauthority-l"; fi
  for _ in $(seq 1 60); do
    if DISPLAY=:0 XAUTHORITY="$HOME/.Xauthority" xdpyinfo >/dev/null 2>&1; then
      export OPENBOT_AGENT_DISPLAY=:0
      exec xvfb-run -a -f "$HOME/.Xauthority" -s "-screen 0 1280x800x24 -nolisten tcp" "${browser_display[@]}"
    fi
    sleep 2
  done
  echo "The boat desktop session did not start. OpenBot uses two virtual displays." >&2
fi

exec xvfb-run -a -s "-screen 0 $(display_size "$requested_size")x24 -nolisten tcp -wr -noreset" \
  bash -c 'command -v xsetroot >/dev/null && xsetroot -cursor_name left_ptr; if [ -r "$1" ]; then bash "$1" </dev/null & fi; shift; export OPENBOT_AGENT_DISPLAY=$DISPLAY; exec xvfb-run -a -f "$XAUTHORITY" -s "-screen 0 1280x800x24 -nolisten tcp" "$@"' \
  openbot-hosted-server /opt/OpenBot/app/resources/hosting/openbot-desktop "${browser_display[@]}"
